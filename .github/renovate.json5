// Automated chart/image/action updates. Renovate opens PRs against main; the
// `validate` check gates them like any other PR. After merge Flux deploys the
// change and trivy-operator rescans the new images, so the
// ImageCriticalVulnerabilities alert clears (or keeps firing) on its own.
// Overview: the "Dependency Dashboard" issue; nothing there needs ticking.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  timezone: "Europe/Stockholm",
  // One batch a week
  schedule: ["* 4-10 * * 6"],
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  labels: ["dependencies"],
  // No limits: an update over a limit waits for a tick on the dashboard
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  // Let fresh releases settle (yanked/broken releases, image re-tags)
  minimumReleaseAge: "3 days",
  // Only Docker Hub and most Helm repositories report release dates. Without this, an
  // update from any other registry (ghcr.io, lscr.io) waits for a tick forever; with
  // it, those skip the soak time.
  minimumReleaseAgeBehaviour: "timestamp-optional",
  // Only rebase on conflicts
  rebaseWhen: "conflicted",
  ignorePaths: [
    ".claude/**",
    ".agents/**",
  ],
  // HelmRelease/OCIRepository chart versions (with their HelmRepository) and
  // the Flux bootstrap manifests
  flux: {
    managerFilePatterns: ["/(^|/)(cluster|components|services)/.+\\.ya?ml$/"],
  },
  // `image:` references in raw manifests and HelmRelease values
  kubernetes: {
    managerFilePatterns: ["/(^|/)(components|services)/.+\\.ya?ml$/"],
  },
  // HelmRelease values that pin an image as `repository:` + `tag:` lines
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)(components|services)/.+\\.ya?ml$/"],
      matchStrings: [
        "repository: (?<depName>[a-z0-9.-]+\\.[a-z]+/[^\\s]+)\\n\\s+tag: \"?(?<currentValue>[^\\s\"]+)\"?",
      ],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    // `:latest` images can't get version bumps; pin them to a digest
    // (`image:latest@sha256:...`) so they only change through a PR and
    // trivy-operator always scans what actually runs
    {
      matchDatasources: ["docker"],
      matchCurrentValue: "latest",
      pinDigests: true,
    },
    // Low-risk: patch releases of apps and observability merge themselves
    // once `validate` passes
    {
      matchFileNames: ["services/**", "components/observability/**", "components/hardware/**"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    // CI-only
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    // Core platform (storage, networking, security, Flux): always
    // reviewed, longer soak time
    {
      matchFileNames: [
        "cluster/**",
        "components/networking/**",
        "components/security/**",
        "components/storage/**",
      ],
      automerge: false,
      minimumReleaseAge: "7 days",
      labels: ["dependencies", "core-infra"],
    },
    // Majors get PRs without a Dependency Dashboard tick; the claude-agent's
    // weekly updates run decides from the release notes whether to merge them
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      labels: ["dependencies", "major"],
    },
  ],
}
