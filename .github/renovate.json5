// Automated chart/image/action updates. Renovate opens PRs against main; the
// `validate` check gates them like any other PR. After merge Flux deploys the
// change and trivy-operator rescans the new images, so the
// ImageCriticalVulnerabilities alert clears (or keeps firing) on its own.
// Overview and approvals: the "Dependency Dashboard" issue.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  timezone: "Europe/Stockholm",
  // One batch a week, outside the 02:00-03:00 Longhorn backup window
  schedule: ["* 4-10 * * 6"],
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  labels: ["dependencies"],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  // Let fresh releases settle (yanked/broken releases, image re-tags)
  minimumReleaseAge: "3 days",
  // The Longhorn backup-sync bot pushes to main daily; only rebase on conflicts
  rebaseWhen: "conflicted",
  ignorePaths: [
    ".claude/**",
    // Legacy, not referenced
    "components/networking/ingress-nginx/**",
    // Bot-maintained restore manifest
    "components/storage/longhorn/config/restore/**",
  ],
  // HelmRelease/OCIRepository chart versions (with their HelmRepository) and
  // the Flux bootstrap manifests
  flux: {
    managerFilePatterns: ["/(^|/)(cluster|components|services)/.+\\.ya?ml$/"],
  },
  // `image:` references in raw manifests and HelmRelease values
  kubernetes: {
    managerFilePatterns: ["/(^|/)(components|services)/.+\\.ya?ml$/"],
  },
  packageRules: [
    // `:latest` images can't get version bumps; pin them to a digest
    // (`image:latest@sha256:...`) so they only change through a PR and
    // trivy-operator always scans what actually runs
    {
      matchDatasources: ["docker"],
      matchCurrentValue: "latest",
      pinDigests: true,
    },
    // Low-risk: patch releases of apps and observability merge themselves
    // once `validate` passes
    {
      matchFileNames: ["services/**", "components/observability/**", "components/hardware/**"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
    },
    // CI-only
    {
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
    // Core platform (storage, networking, auth, admission, Flux): always
    // reviewed, longer soak time
    {
      matchFileNames: [
        "cluster/**",
        "components/networking/**",
        "components/security/**",
        "components/storage/**",
      ],
      automerge: false,
      minimumReleaseAge: "7 days",
      labels: ["dependencies", "core-infra"],
    },
    // Longhorn only supports upgrading from the previous minor: one PR per
    // minor, merge them in order
    {
      matchPackageNames: ["longhorn", "/^longhornio//"],
      separateMultipleMinor: true,
      prBodyNotes: [
        "**Longhorn upgrade checklist**: merge one minor at a time (oldest first); before merging check that no volume is `Faulted` and the latest daily backups completed (`kubectl --context=oidc-user -n longhorn-system get volumes.longhorn.io,backups.longhorn.io`); read the version's important notes. Engines are live-upgraded afterwards (`concurrentAutomaticEngineUpgradePerNodeLimit`).",
      ],
    },
    // Majors need an explicit go from the Dependency Dashboard
    {
      matchUpdateTypes: ["major"],
      automerge: false,
      dependencyDashboardApproval: true,
      labels: ["dependencies", "major"],
    },
  ],
}
